{
  "manifest_version": 3,
  "name": "Roast My Browsing History",
  "version": "1.0.0",
  "description": "Your browser remembers. Now it has opinions.",
  "permissions": ["history"],
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
